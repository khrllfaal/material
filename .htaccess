# Root of the site: open the app when someone visits the bare domain
# (otherwise the server shows 403 Forbidden because no index file exists
# here), and keep non-app files private.
DirectoryIndex index.html frontend/index.html
Options -Indexes

# Project files that must never be downloadable.
RedirectMatch 403 ^/(docs|scripts|\.git)(/|$)
# Folder pendamping API (susunan api/ + backend/): tidak pernah dilayani lewat web.
RedirectMatch 403 ^/backend/(backups|sessions|mysql)(/|$)
<FilesMatch "\.(sql|gz|md|sample|sh|bak|zip|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# --- HTTPS (SSL) ------------------------------------------------------------
# Hostinger gives every domain a free SSL certificate. Turn on "Force HTTPS"
# in hPanel (Websites > Security > SSL) -- or remove the leading '#' on the lines
# below -- so every visit and every password is encrypted in transit.
