# Block direct access to anything that isn't a PHP entry point.
<FilesMatch "\.(sql|md|sample)$">
    Require all denied
</FilesMatch>
<FilesMatch "^(config|helpers|db|payroll_lib|resource_crud|scoped_resource)\.php$">
    Require all denied
</FilesMatch>
# CLI tools, session files and the class library (src/) are never served over HTTP.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(bin|sessions|src)/ - [F,L]
</IfModule>

# Never let Apache list this directory's contents.
Options -Indexes

# These are API endpoints only — no HTML is ever served from here, so
# there's no reason a browser should try to render a response as
# anything but plain data.
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    # Browser hanya memakai HTTPS untuk situs ini (dikirim hanya bila sambungan memang HTTPS, termasuk lewat Cloudflare).
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} == 'https'"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header set X-Frame-Options "DENY"
</IfModule>

# JSON compresses very well (often 80%+ smaller) — this API's biggest
# response is the full transaction list fetched once at login, so
# compressing it is a real, noticeable speed win, especially on mobile.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# LiteSpeed (Hostinger) page cache: never cache API answers.
<IfModule LiteSpeed>
    RewriteEngine On
    RewriteRule .* - [E=Cache-Control:no-cache]
</IfModule>
